import { promises as fs } from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.join(__dirname, '..');

export async function ensureAssets() {
  const imageDir = path.join(rootDir, 'assets', 'images');
  await fs.mkdir(imageDir, { recursive: true });

  const svgFiles = {
    'poster.webp': '',
    'prod-1.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><rect x="40" y="40" width="520" height="620" fill="#111" stroke="#FF6A00" stroke-width="4"/><circle cx="300" cy="250" r="120" fill="#FF6A00" opacity="0.9"/><path d="M220 430 L300 200 L380 430 Z" fill="#fff" opacity="0.95"/><rect x="175" y="440" width="250" height="20" fill="#FF6A00"/><text x="300" y="560" text-anchor="middle" fill="#fff" font-size="42" font-family="Arial, sans-serif">AKANESHI</text></svg>`,
    'prod-2.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><rect x="140" y="80" width="320" height="540" rx="30" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M220 180 L380 180 L450 520 L150 520 Z" fill="#FF6A00" opacity="0.8"/><path d="M170 240 L430 240" stroke="#fff" stroke-width="14"/><circle cx="300" cy="290" r="90" fill="#fff"/><text x="300" y="425" text-anchor="middle" fill="#000" font-size="58" font-family="Arial, sans-serif">A</text></svg>`,
    'prod-3.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><circle cx="300" cy="210" r="120" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M220 430 L300 160 L380 430 Z" fill="#fff"/><rect x="200" y="490" width="200" height="26" fill="#FF6A00"/><text x="300" y="585" text-anchor="middle" fill="#fff" font-size="30" font-family="Arial, sans-serif">COLLECTOR</text></svg>`,
    'prod-4.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><rect x="70" y="70" width="460" height="560" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M120 190 L480 190" stroke="#FF6A00" stroke-width="8"/><path d="M120 250 L480 250" stroke="#fff" stroke-width="3"/><path d="M120 420 L480 420" stroke="#FF6A00" stroke-width="8"/><text x="300" y="330" text-anchor="middle" fill="#fff" font-size="52" font-family="Arial, sans-serif">ARCHIVE</text></svg>`,
    'prod-5.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><circle cx="300" cy="330" r="150" fill="#111" stroke="#FF6A00" stroke-width="5"/><circle cx="300" cy="330" r="65" fill="#FF6A00"/><path d="M300 110 L350 260 L300 520 L250 260 Z" fill="#fff"/><text x="300" y="610" text-anchor="middle" fill="#fff" font-size="32" font-family="Arial, sans-serif">SIGNAL</text></svg>`,
    'prod-6.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><rect x="135" y="90" width="330" height="520" rx="28" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M210 170 L390 170 L430 520 L170 520 Z" fill="#fff" opacity="0.95"/><rect x="200" y="210" width="200" height="18" fill="#FF6A00"/><circle cx="300" cy="330" r="70" fill="#000"/><text x="300" y="505" text-anchor="middle" fill="#000" font-size="28" font-family="Arial, sans-serif">AK</text></svg>`,
    'prod-7.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><path d="M120 520 L230 180 L370 180 L480 520 Z" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M210 240 L390 240" stroke="#fff" stroke-width="10"/><rect x="220" y="250" width="160" height="170" fill="#FF6A00" opacity="0.9"/><text x="300" y="580" text-anchor="middle" fill="#fff" font-size="38" font-family="Arial, sans-serif">NOIR</text></svg>`,
    'prod-8.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700"><rect width="600" height="700" fill="#000"/><rect x="170" y="130" width="260" height="440" rx="42" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M200 220 H400" stroke="#FF6A00" stroke-width="8"/><path d="M200 310 H400" stroke="#fff" stroke-width="3"/><path d="M200 395 H400" stroke="#FF6A00" stroke-width="8"/><circle cx="300" cy="250" r="52" fill="#fff"/></svg>`,
    'blog-1.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500"><rect width="800" height="500" fill="#000"/><rect x="120" y="90" width="560" height="320" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M180 150 L620 150" stroke="#FF6A00" stroke-width="6"/><path d="M180 230 L620 230" stroke="#fff" stroke-width="2"/><path d="M180 310 L620 310" stroke="#FF6A00" stroke-width="6"/><circle cx="400" cy="230" r="80" fill="#FF6A00" opacity="0.8"/></svg>`,
    'blog-2.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500"><rect width="800" height="500" fill="#000"/><path d="M150 360 L350 120 L650 360 Z" fill="#111" stroke="#FF6A00" stroke-width="4"/><path d="M280 360 L400 220 L520 360 Z" fill="#FF6A00" opacity="0.8"/><rect x="200" y="120" width="20" height="220" fill="#fff"/><rect x="580" y="120" width="20" height="220" fill="#fff"/></svg>`,
    'blog-3.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500"><rect width="800" height="500" fill="#000"/><rect x="160" y="100" width="480" height="300" fill="#111" stroke="#FF6A00" stroke-width="4"/><circle cx="400" cy="250" r="100" fill="#FF6A00" opacity="0.8"/><path d="M300 250 L400 180 L500 250 L400 320 Z" fill="#fff"/><text x="400" y="430" text-anchor="middle" fill="#fff" font-size="36" font-family="Arial, sans-serif">STUDIO</text></svg>`,
    'og-cover.svg': `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630"><rect width="1200" height="630" fill="#000"/><rect x="90" y="80" width="1020" height="470" fill="#111" stroke="#FF6A00" stroke-width="6"/><text x="600" y="260" text-anchor="middle" fill="#fff" font-size="118" font-family="Arial, sans-serif">AKANESHI</text><text x="600" y="350" text-anchor="middle" fill="#FF6A00" font-size="44" font-family="Arial, sans-serif">ANIME CULTURE. STREETWEAR. COLLECTIBLES.</text></svg>`
  };

  for (const [fileName, content] of Object.entries(svgFiles)) {
    const fullPath = path.join(imageDir, fileName);
    await fs.writeFile(fullPath, content, { encoding: 'utf8' }).catch(() => {});
  }

  const videoPath = path.join(rootDir, 'assets', 'video.webm');
  await fs.writeFile(videoPath, '', { encoding: 'utf8' }).catch(() => {});
}
